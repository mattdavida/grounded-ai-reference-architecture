# Copy to .env and fill in values.
# Run .\infra\deploy.ps1 to provision Azure resources and get a ready-to-paste block.

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./dev.db
# LOG_LEVEL=INFO

# ── Azure OpenAI (LangGraph chat pipeline) ────────────────────────────────────
# Provisioned by infra/modules/openai.bicep — values printed by deploy.ps1.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4

# ── Azure Speech Services (speech token endpoint) ─────────────────────────────
# Provisioned by infra/modules/speech.bicep by default (deploy.ps1).
# If you reused an existing F0 Speech resource (deploy.ps1 -SkipSpeech), set
# these manually from that account. Key stays server-side; /api/speech/token
# exchanges it for a 10-min browser token.
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=eastus

# ── LangGraph conversation checkpointer ───────────────────────────────────────
# CHECKPOINTS_DB=./voice_chat.db

# ── Agent tools (Phase 4 ToolNode) ────────────────────────────────────────────
# Default true. Set false to keep chat on precomputed context only.
# VOICE_CHAT_TOOLS_ENABLED=true

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend runs on port 4001 locally.
# ALLOWED_ORIGINS=http://localhost:4001
